# Copia este archivo como ".env" y llena los valores.
# El archivo real (.env) esta protegido por .gitignore: no se sube a ningun repositorio.

# Correo de Gmail que envia las alertas. Debe tener activada la verificacion en 2 pasos.
EMAIL_USER=tu.correo@gmail.com

# Contraseña de APLICACION de Google (16 caracteres con espacios),
# NO tu contraseña normal de Gmail.
# Se consigue en: myaccount.google.com > Seguridad > Verificacion en 2 pasos > Contraseñas de aplicacion
EMAIL_PASS=xxxx xxxx xxxx xxxx

# A quien le llegan los avisos (puede ser el mismo correo)
EMAIL_TO=tu.correo@gmail.com

# Nombre que aparece como remitente
EMAIL_FROM_NOMBRE=Notificador de Vacantes MEP

# Portal del MEP que se consulta
TARGET_URL=https://apps.mep.go.cr/formulario

# Solo se notifican vacantes cuya especialidad contenga esta palabra
ESPECIALIDAD_BUSCADA=Música

# --- Nube (GitHub Actions + MongoDB Atlas) ---
# Solo se necesita si vas a usar la version que corre sola en la nube.
# Connection string: Atlas > Database Access > Connect > Drivers
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net
MONGO_BD=notificador
